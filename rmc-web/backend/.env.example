# Copy to .env and fill in. Never commit .env.

PORT=5000

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017/rms

# Signing key for session tokens. Must be at least 32 characters; the server
# refuses to start otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this value invalidates every issued token, forcing all users to log
# in again.
JWT_SECRET=

# How long a session token stays valid. Default 7d.
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API. Defaults to the local
# dev server when unset. The mobile app sends no Origin header and is unaffected.
CORS_ORIGINS=http://localhost:3000

# Set to true when the app runs behind a reverse proxy (Render, nginx) so client
# IPs are read from X-Forwarded-For for rate limiting.
TRUST_PROXY=false

# Required by scripts/seedUsers.js to create the first administrator.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_CIN=
