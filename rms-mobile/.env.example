# Copy to .env and set the address your device can reach.
#
# A phone or emulator cannot reach the host machine's localhost, so use the
# host's LAN IP in development. Find it with `ipconfig` on Windows.
#
# Expo inlines EXPO_PUBLIC_* variables at build time, so restart the dev server
# after changing this file.

EXPO_PUBLIC_API_URL=http://192.168.100.193:5000/api
